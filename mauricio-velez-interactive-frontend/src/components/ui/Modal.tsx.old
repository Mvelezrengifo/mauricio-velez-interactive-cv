'use client';

import { motion, AnimatePresence } from 'framer-motion';
import { Project, Language } from '@/types/mountain';

interface ModalProps {
  project: Project | null;
  language: Language;
  onClose: () => void;
}

export default function Modal({ project, language, onClose }: ModalProps) {
  if (!project) return null;

  const desc = language === 'es' ? project.descriptionEs : project.descriptionEn;

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        exit={{ opacity: 0 }}
        className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm"
        onClick={onClose}
      >
        <motion.div
          initial={{ scale: 0.9, y: 20 }}
          animate={{ scale: 1, y: 0 }}
          exit={{ scale: 0.9, y: 20 }}
          className="bg-gray-900 rounded-xl max-w-lg w-full mx-4 p-6 border border-blue-500/30 shadow-2xl"
          onClick={(e) => e.stopPropagation()}
        >
          <h3 className="text-2xl font-bold text-blue-400 mb-2">{project.name}</h3>
          <div className="flex flex-wrap gap-2 mb-4">
            {project.technologies.map((tech) => (
              <span key={tech} className="px-2 py-1 text-xs bg-blue-500/20 text-blue-300 rounded-full">
                {tech}
              </span>
            ))}
          </div>
          <p className="text-gray-300 mb-6">{desc}</p>
          {project.image && (
            <img src={project.image} alt={project.name} className="rounded-lg mb-4 max-h-40 object-cover" />
          )}
          <button
            onClick={onClose}
            className="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors"
          >
            {language === 'es' ? 'Cerrar' : 'Close'}
          </button>
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}